# systemd EnvironmentFile syntax, not a shell script. No credentials required.
SENTINEL_AI_BACKEND=classifiers
PRAMAN_SIGNUP_ENABLED=true
PRAMAN_DATABASE_PATH=/opt/praman/data/praman.db
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
OMP_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
PYTHONUTF8=1
PYTHONUNBUFFERED=1
PRAMAN_QWEN_THREADS=2
